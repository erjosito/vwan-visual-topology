      "rules": [
        {
          "id": "rule-weu-er-out-1",
          "prefixes": [
            "10.0.0.0/8"
          ],
          "match": "contains",
          "action": "prepend",
          "summaryPrefixes": [],
          "prepend": [
            64496,
            64496
          ],
          "nextStep": "continue"
        }
      ]
    },
    {

{
  "name": "vwan-visual-topology",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix api run build",
    "package:api": "node scripts/package-feedback-api.mjs",
    "lint": "oxlint",
